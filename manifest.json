{
  "manifest_version": 2,
  "name": "FormTexter",
  "version": "1.0.0",
  "description": "Automatische Zuordnung von kommagetrennten Freitexten zu Checkboxen in Formularen.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    "overlay/overlay.html",
    "overlay/overlay.css",
    "overlay/overlay.js"
  ]
}